generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

// ─────────────────────────────────────────────────────────
// Tenant — uma linha por clínica cadastrada no SaaS
// slug        → subdomínio legível  (ex: clinicaabc)
// schema_name → schema PG real      (ex: clinica_abc)
// ─────────────────────────────────────────────────────────
model Tenant {
  id           String          @id @default(uuid())
  slug         String          @unique
  schema_name  String          @unique
  nome         String
  status       TenantStatus    @default(ATIVO)
  plano_id     String
  plano        Plano           @relation(fields: [plano_id], references: [id])
  faturamentos FaturamentoSaas[]
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt

  @@schema("public")
}

enum TenantStatus {
  ATIVO
  INATIVO
  SUSPENSO

  @@schema("public")
}

// ─────────────────────────────────────────────────────────
// Plano — planos de assinatura disponíveis no SaaS
// ─────────────────────────────────────────────────────────
model Plano {
  id              String    @id @default(uuid())
  nome            String
  descricao       String?
  preco_mensal    Decimal   @db.Decimal(10, 2)
  limite_usuarios Int
  ativo           Boolean   @default(true)
  tenants         Tenant[]
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@schema("public")
}

// ─────────────────────────────────────────────────────────
// FaturamentoSaas — cobranças mensais por clínica
// ─────────────────────────────────────────────────────────
model FaturamentoSaas {
  id             String            @id @default(uuid())
  tenant_id      String
  tenant         Tenant            @relation(fields: [tenant_id], references: [id])
  mes_referencia DateTime          @db.Date
  valor          Decimal           @db.Decimal(10, 2)
  status         FaturamentoStatus @default(PENDENTE)
  vencimento     DateTime          @db.Date
  pago_em        DateTime?
  created_at     DateTime          @default(now())

  @@schema("public")
}

enum FaturamentoStatus {
  PENDENTE
  PAGO
  VENCIDO

  @@schema("public")
}
