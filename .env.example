# ===== DATABASE =====
DATABASE_URL="postgresql://clinica_user:clinica_password_dev@localhost:5432/saas_clinica?schema=public"

# ===== REDIS =====
REDIS_URL="redis://localhost:6379"

# ===== JWT =====
JWT_SECRET="sua_chave_secreta_super_segura_aqui_mudar_em_producao"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="sua_chave_refresh_super_segura_aqui_mudar_em_producao"
JWT_REFRESH_EXPIRATION="7d"

# ===== BCRYPT =====
BCRYPT_ROUNDS=12

# ===== AMBIENTE =====
NODE_ENV="development"
PORT=3000

# ===== CLOUDFLARE R2 (arquivos) =====
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="saas-clinica"
R2_ENDPOINT="https://[accountid].r2.cloudflarestorage.com"

# ===== LOGGING =====
LOG_LEVEL="debug"

# ===== CORS =====
CORS_ORIGIN="http://localhost:3001,http://localhost:3000"

# ===== TENANT =====
# Domínio base para subdomínios (ex: clinicaabc.dev.seuapp.com)
TENANT_DOMAIN="dev.seuapp.com"
